# ========================================================
# Wander Roleplay Discord Bot Environment Configuration
# ========================================================

# Token bot Discord dari https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Client ID / Application ID bot Discord
CLIENT_ID=your_client_id_here

# (Opsional) Guild ID untuk register slash command instan saat development
# Jika dikosongkan, slash command akan didaftarkan secara Global ke semua server
GUILD_ID=

# Lokasi file database SQLite
DATABASE_PATH=./data/wander.sqlite
